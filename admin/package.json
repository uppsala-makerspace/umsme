{
  "name": "umsme",
  "private": true,
  "scripts": {
    "build": "meteor build dist --architecture os.linux.x86_64",
    "start": "meteor run --settings settings.json",
    "demo": "MONGO_URL=mongodb://localhost:27017/umsme-demo?replicaSet=rs0 meteor run --port 3100 --settings settings_demo.json",
    "seed:demo": "SEED=demo npm run demo",
    "start:test": "SEED=e2e MONGO_URL=mongodb://localhost:27017/umsme-admin-e2e?replicaSet=rs0 meteor run --production --port 3200 --settings settings_demo.json",
    "start:test:dev": "SEED=e2e MONGO_URL=mongodb://localhost:27017/umsme-admin-e2e?replicaSet=rs0 meteor run --port 3200 --settings settings_demo.json",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o storybook-static",
    "test": "TEST_CLIENT=0 TEST_SERVER=1 meteor test --once --port 3100 --driver-package meteortesting:mocha"
  },
  "dependencies": {
    "@babel/runtime": "^7.17.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.15.0",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.4.8",
    "chartjs-adapter-moment": "^1.0.1",
    "google-auth-library": "^9.15.0",
    "iconv-lite": "^0.7.3",
    "marked": "^18.0.14",
    "meteor-node-stubs": "^1.2.1",
    "moment": "^2.30.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.30.6",
    "remove-markdown": "^0.6.3",
    "underscore": "^1.13.7",
    "web-push": "^3.6.7"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.jsx",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-webpack5": "^9.1.20",
    "storybook": "^9.1.20"
  }
}
